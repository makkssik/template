# Локальные настройки HTTP-сервера; make run загружает их перед .env от tripgoctl.
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# ЛР3: ограниченная очередь и выборка батчами.
POSITION_CHECK_INTERVAL=30s
POSITION_STALE_AFTER=60s
POSITION_WORKERS=4
POSITION_QUEUE_SIZE=100
POSITION_SCAN_BATCH_SIZE=100
PUSH_REQUEST_TIMEOUT=1s
PUSH_KEEP_ALIVE=30s
PUSH_IDLE_CONN_TIMEOUT=90s
